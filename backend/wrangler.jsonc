{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "wouncy-api",
  "main": "index.js",
  "compatibility_date": "2026-11-14",
  "vars": {
    "ALLOWED_ORIGINS": "https://html-classic.itch.zone,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4180,http://127.0.0.1:4180"
  },
  "durable_objects": {
    "bindings": [
      {"name":"ROOMS","class_name":"WouncyRoom"},
      {"name":"LIMITS","class_name":"RequestLimits"},
      {"name":"RUNS","class_name":"WouncyRun"}
    ]
  },
  "migrations": [{"tag":"v1","new_sqlite_classes":["WouncyRoom","RequestLimits"]},{"tag":"v2","new_sqlite_classes":["WouncyRun"]}],
  "d1_databases": [{"binding":"DB","database_name":"wouncy-scores","database_id":"55641999-4b36-41d2-8fb6-09be4eabda6a","migrations_dir":"migrations"}]
}
